<?xml version="1.0"?>
<ruleset>
    <!-- Contributte Coding Standard -->
    <rule ref="./vendor/contributte/qa/ruleset.xml"/>

    <!-- Specific rules -->
    <rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
        <properties>
            <property name="rootNamespaces" type="array">
                <element key="src" value="Webnazakazku\MangoTester\HttpMocks"/>
            </property>
            <property name="extensions" type="array">
                <element value="php"/>
                <element value="phpt"/>
            </property>
        </properties>
        <exclude name="SlevomatCodingStandard.PHP.DisallowReference.DisallowedReturningReference" />
        <exclude name="SlevomatCodingStandard.Functions.DisallowEmptyFunction.EmptyFunction" />
    </rule>

    <!-- Exclude folders -->
    <exclude-pattern>/tests/tmp</exclude-pattern>
</ruleset>
